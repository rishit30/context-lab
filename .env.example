# Copy to .env in the project root and enter your key locally.
# Each loader reads only its named key; an exported value takes precedence.
# Values may be quoted. Shell commands and variable expansion are never evaluated.
# .env is gitignored and excluded from Docker builds and run artifacts.
ANTHROPIC_API_KEY=
# Used only for Typesafe integration; keep the value local.
TYPESAFE_API_KEY=
